<%- include('./partials/header') %>

<section class="content admin-page">
    <h1>Booking Admin</h1>
    <p>
        <% if (currentUser && currentUser.role === 'admin') { %>
            Manage every booking in the system.
        <% } else { %>
            Manage the bookings where you are listed as a passenger.
        <% } %>
    </p>

    <div class="admin-state" id="bookings-loading">Loading bookings...</div>
    <div class="admin-state admin-error" id="bookings-error" hidden></div>
    <div class="admin-state" id="bookings-empty" hidden>No bookings found.</div>

    <div class="admin-list" id="bookings-list"></div>

    <template id="booking-card-template">
        <article class="admin-card booking-card-admin">
            <header class="admin-card-header">
                <h2 data-field="id"></h2>
                <span class="admin-card-meta" data-field="createdAt"></span>
            </header>

            <dl class="admin-card-details">
                <div class="detail-item">
                    <dt>Trip</dt>
                    <dd data-field="tripId"></dd>
                </div>
                <div class="detail-item">
                    <dt>Schedule</dt>
                    <dd data-field="scheduleId"></dd>
                </div>
                <div class="detail-item">
                    <dt>Ticket Class</dt>
                    <dd data-field="ticketClass"></dd>
                </div>
                <div class="detail-item">
                    <dt>Day</dt>
                    <dd data-field="selectedDay"></dd>
                </div>
            </dl>

            <div class="admin-card-passengers">
                <h3>Passengers</h3>
                <ul data-field="passengers"></ul>
            </div>

            <div class="admin-card-actions">
                <button type="button" class="btn btn-secondary" data-action="edit">Edit</button>
                <button type="button" class="btn btn-danger" data-action="delete">Delete</button>
            </div>

            <form class="admin-edit-form" data-role="edit-form" hidden>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">
                            Ticket Class
                            <select name="ticketClass" class="form-input">
                                <option value="standard">Standard Class</option>
                                <option value="premium">Premium Class</option>
                                <option value="first">First Class</option>
                            </select>
                        </label>
                    </div>
                    <div class="form-group">
                        <label class="form-label">
                            Day
                            <select name="selectedDay" class="form-input">
                                <option value="monday">Monday</option>
                                <option value="tuesday">Tuesday</option>
                                <option value="wednesday">Wednesday</option>
                                <option value="thursday">Thursday</option>
                                <option value="friday">Friday</option>
                                <option value="saturday">Saturday</option>
                                <option value="sunday">Sunday</option>
                            </select>
                        </label>
                    </div>
                </div>

                <div data-role="passenger-fields"></div>

                <p class="admin-form-error" data-role="form-error" hidden></p>

                <div class="admin-card-actions">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-action="cancel">Cancel</button>
                </div>
            </form>
        </article>
    </template>
</section>

<script src="/js/bookings-admin.js"></script>

<%- include('./partials/footer') %>
